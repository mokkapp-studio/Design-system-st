{
  "name": "design-contracts",
  "version": "1.1.0",
  "private": true,
  "description": "Del prompt a la especificación: un sistema de diseño gobernado por contratos para personas y agentes de IA.",
  "author": "Xavier Pascual · Mokkapp.com (https://mokkapp.com)",
  "license": "MIT",
  "scripts": {
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build",
    "start": "next start",
    "tokens": "tsx scripts/build-tokens.ts",
    "registry:md": "tsx scripts/build-registry-md.ts",
    "generate": "npm run tokens && npm run registry:md",
    "check:generated": "tsx scripts/build-tokens.ts --check && tsx scripts/build-registry-md.ts --check",
    "validate": "tsx registry/validate.ts",
    "test": "vitest run",
    "check": "npm run check:generated && npm run validate && npm run test"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
