{
  "name": "Input",
  "version": "1.0.0",
  "status": "stable",
  "owner": "Xavier Pascual · Mokkapp.com",
  "description": "Campo de texto de una línea con su etiqueta, ayuda y mensaje de error.",
  "files": {
    "component": "components/input/input.tsx",
    "styles": "components/input/input.css",
    "test": "components/input/input.spec.ts"
  },
  "anatomy": ["etiqueta", "campo", "texto de ayuda (opcional)", "mensaje de error (opcional)"],
  "props": {
    "label": { "type": "string", "required": true, "description": "Etiqueta visible. Siempre presente: el placeholder no la sustituye" },
    "type": { "type": "enum", "values": ["text", "email", "password", "search", "tel", "url", "number"], "default": "text", "description": "Tipo de dato" },
    "name": { "type": "string", "required": false, "description": "Nombre del campo en el formulario" },
    "placeholder": { "type": "string", "required": false, "description": "Ejemplo de formato, nunca instrucciones" },
    "hint": { "type": "string", "required": false, "description": "Ayuda breve bajo el campo" },
    "error": { "type": "string", "required": false, "description": "Mensaje de error. Si existe, el campo pasa a estado inválido" },
    "required": { "type": "boolean", "default": false, "description": "Campo obligatorio" },
    "disabled": { "type": "boolean", "default": false, "description": "Campo desactivado" }
  },
  "states": ["default", "hover", "focus", "error", "disabled"],
  "tokens": {
    "background": "color.field.bg",
    "border": "color.field.border",
    "border-hover": "color.field.border-hover",
    "border-focus": "color.field.border-focus",
    "text": "color.field.text",
    "placeholder": "color.field.placeholder",
    "label.text": "color.text.primary",
    "hint.text": "color.text.secondary",
    "error.text": "color.feedback.error.text",
    "error.border": "color.feedback.error.border",
    "disabled.background": "color.action.disabled.bg",
    "disabled.text": "color.action.disabled.text",
    "focus.ring": "color.focus.ring",
    "focus.width": "size.border.focus",
    "border.width": "size.border.default",
    "radius": "size.radius.control",
    "height": "size.control.height",
    "padding.x": "size.space.field-x",
    "padding.y": "size.space.control-y",
    "gap": "size.space.field-gap",
    "font.family": "font.body.family",
    "font.size": "font.body.size",
    "label.font.family": "font.label.family",
    "label.font.size": "font.label.size",
    "label.font.weight": "font.label.weight",
    "helper.font.family": "font.helper.family",
    "helper.font.size": "font.helper.size"
  },
  "content": {
    "guideline": "content/voice.md#formularios",
    "maxWords": 4
  },
  "a11y": {
    "element": "input",
    "label": "La etiqueta está asociada al campo con for/id",
    "description": "Ayuda y error se enlazan con aria-describedby",
    "invalid": "Con error, el campo lleva aria-invalid=\"true\"",
    "contrast": "Borde del campo ≥ 3:1 y textos ≥ 4.5:1"
  },
  "rules": {
    "always": [
      "Mostrar siempre una etiqueta visible",
      "Explicar el error y cómo solucionarlo",
      "Usar solo los tokens declarados en este contrato"
    ],
    "never": [
      "Usar el placeholder como etiqueta",
      "Indicar el error solo con color",
      "Sombras (box-shadow) o fondos de color en estado de error",
      "Valores hex o px escritos a mano"
    ]
  },
  "decisions": [
    {
      "decision": "Error en rojo solo en borde y mensaje",
      "why": "El fondo rojo genera ansiedad y compite con la marca monocroma. Además, el mensaje en texto hace que el error no dependa solo del color."
    },
    {
      "decision": "Nuevo primitivo color.rust.700 para errores",
      "why": "El acento clay no llega a 4.5:1 sobre crema. rust.700 cumple AA en todas las superficies y clay sigue sin uso en la interfaz."
    }
  ],
  "openQuestions": [
    "¿Necesitamos un estado de éxito o validación en tiempo real?"
  ]
}
